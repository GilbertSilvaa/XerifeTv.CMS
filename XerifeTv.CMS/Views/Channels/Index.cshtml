@using XerifeTv.CMS.Modules.Channel.Dtos.Response
@using XerifeTv.CMS.Modules.Channel.Enums

@model IEnumerable<GetChannelResponseDto>;

@{
    ViewData["Title"] = "Canais";

    ICollection<string[]> filters = [];
    filters.Add([EChannelSearchFilter.TITLE.ToString().ToLower(), "Título"]);
    filters.Add([EChannelSearchFilter.CATEGORY.ToString().ToLower(), "Categoria"]);
}

<div class="container">
    <header>
        <div class="d-flex align-items-center justify-content-between gap-4">
            <span class="fs-3 fw-normal">Canais</span>

            @if (!User.IsInRole("visitor"))
            {
                <a class="btn btn-primary" asp-controller="Channels" asp-action="Form">
                    <i class="fa-solid fa-plus"></i> Cadastrar
                </a>
            }
        </div>
        <hr />
    </header>

    <div class="row mb-3 justify-content-between">
        <a class="d-none d-md-block col-1 fs-5" role="button" asp-controller="Channels" asp-action="Index">
            <i class="fa-solid fa-rotate"></i>
        </a>

        <div class="col-md-8 col-lg-5 d-flex align-items-center gap-2">
            <form class="input-group input-group-sm flex-grow-1"
                  asp-controller="Channels"
                  asp-action="Index"
                  method="get">

                @* <input type="hidden"
                   name="currentPage"
                   value="@(ViewBag.Filter is not null ? ViewBag.CurrentPage : 1)" /> *@

                <select class="form-select shadow-none" name="filter">
                    @foreach (var filter in filters)
                    {
                        if (filter[0].Equals(ViewBag.Filter))
                        {
                            <option value="@filter[0]" selected>@filter[1]</option>
                        }
                        else
                        {
                            <option value="@filter[0]">@filter[1]</option>
                        }
                    }
                </select>

                <input type="text"
                       name="search"
                       class="form-control shadow-none"
                       value="@ViewBag.Search"
                       required>
                <button class="btn btn-success shadow-none" type="submit">
                    <i class="fa-solid fa-magnifying-glass"></i>
                </button>
            </form>

            <div class="btn-group btn-group-sm flex-shrink-0 d-none d-md-flex" role="group" aria-label="Modo de visualização">
                <button type="button" class="btn btn-outline-secondary shadow-sm" data-view="grid" title="Grade">
                    <i class="fa-solid fa-table-cells-large"></i>
                </button>
                <button type="button" class="btn btn-outline-secondary shadow-sm" data-view="table" title="Tabela">
                    <i class="fa-solid fa-table-list"></i>
                </button>
            </div>
        </div>
    </div>


    @await Html.PartialAsync("_VideoModal")

    <div id="gridView" class="row gap-3">
        @foreach (var channel in Model)
        {
            <div class="card col-md-4 col-xl-2 pt-2">
                <div class="w-auto h-100 position-relative">
                    <img src="@channel.LogoUrl"
                         onerror="this.onerror=null; this.src='/assets/poster_default.jpg';"
                         class="card-img-top object-fit-cover"
                         alt="@channel.Title"
                         loading="lazy"
                         style="height: 9rem;" />

                    @if (channel.Disabled)
                    {
                        <span class="position-absolute text-danger"
                              style="top: 6px; left: 8px; font-size: 24px;">
                            <i class="fa-solid fa-circle-exclamation"></i>
                        </span>
                    }

                </div>

                <div class="card-body" style="padding: 1rem 0.25rem;">
                    <h5 class="card-title text-nowrap overflow-hidden text-truncate text-center">@channel.Title</h5>

                    <div class="d-flex justify-content-center gap-2 mt-3">
                        <a class="btn btn-sm btn-info"
                           data-bs-toggle="modal"
                           data-bs-target="#videoModal"
                           data-bs-title="@channel.Title"
                           data-bs-banner="@channel.LogoUrl"
                           data-bs-video-resolver="@channel?.UrlResolverPath">
                            <i class="fa-solid fa-play"></i> Play
                        </a>

                        @if (!User.IsInRole("visitor"))
                        {
                            <a class="btn btn-sm btn-primary"
                               asp-controller="Channels"
                               asp-action="Form"
                               asp-route-id="@channel?.Id">
                                <i class="fa-solid fa-pen-to-square"></i> Editar
                            </a>
                        }

                    </div>
                </div>
            </div>
        }
    </div>

    <div id="tableView" class="table-responsive d-none">
        <table class="table table-hover table-sm align-middle">
            <thead>
                <tr>
                    <th style="width: 88px;"></th>
                    <th class="p-2">Título</th>
                    <th class="p-2">Status</th>
                    <th class="text-end p-2">...</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var channel in Model)
                {
                    <tr>
                        <td>
                            <img src="@channel.LogoUrl"
                                 onerror="this.onerror=null; this.src='/assets/poster_default.jpg';"
                                 class="rounded object-fit-cover"
                                 width="72" height="40"
                                 alt="@channel.Title"
                                 loading="lazy" />
                        </td>
                        <td class="fw-semibold">@channel.Title</td>
                        <td>
                            @if (channel.Disabled)
                            {
                                <span class="badge text-bg-danger">Desativado</span>
                            }
                            else
                            {
                                <span class="badge text-bg-success">Ativo</span>
                            }
                        </td>
                        <td class="text-end text-nowrap">
                            <a class="btn btn-sm btn-outline-info shadow-sm"
                               data-bs-toggle="modal"
                               data-bs-target="#videoModal"
                               data-bs-title="@channel.Title"
                               data-bs-banner="@channel.LogoUrl"
                               data-bs-video-resolver="@channel.UrlResolverPath"
                               title="Play">
                                <i class="fa-solid fa-play"></i>
                            </a>

                            @if (!User.IsInRole("visitor"))
                            {
                                <a class="btn btn-sm btn-outline-primary shadow-sm"
                                   asp-controller="Channels"
                                   asp-action="Form"
                                   asp-route-id="@channel.Id"
                                   title="Editar">
                                    <i class="fa-solid fa-pen-to-square"></i>
                                </a>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @if (!Model.Any())
    {
        <p>Nenhum registro encontrado.</p>
    }

    @await Html.PartialAsync("_Pagination")
</div>

<script>
    (function () {
        const KEY = 'channels:view';
        const grid = document.getElementById('gridView');
        const table = document.getElementById('tableView');
        const buttons = document.querySelectorAll('[data-view]');

        function apply(view) {
            const isTable = view === 'table' && window.matchMedia('(min-width: 768px)').matches;
            grid.classList.toggle('d-none', isTable);
            table.classList.toggle('d-none', !isTable);
            buttons.forEach(b => b.classList.toggle('active', b.dataset.view === (isTable ? 'table' : 'grid')));
        }

        let saved = 'grid';
        try { saved = localStorage.getItem(KEY) || 'grid'; } catch (e) { }
        apply(saved);

        buttons.forEach(b => b.addEventListener('click', function () {
            apply(b.dataset.view);
            try { localStorage.setItem(KEY, b.dataset.view); } catch (e) { }
        }));
    })();
</script>
