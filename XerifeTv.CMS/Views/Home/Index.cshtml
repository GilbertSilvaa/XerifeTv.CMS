@using XerifeTv.CMS.Modules.Dashboard.Dtos.Response;
@using XerifeTv.CMS.Shared.Extensions

@model GetDashboardDataRequestDto;

@{
    ViewData["Title"] = "Dashboard";
}

<style>
    .cards-statistics {
        max-width: 49%;
    }

    @@media (max-width: 800px) {
        .cards-statistics {
            max-width: 100%;
            margin-top: 1rem;
        }

        .card-dashboard {
            width: 100%;
        }
    }
</style>

<div class="container">
    <header>
        <div class="d-flex align-items-center justify-content-between gap-4">
            <span class="fs-3 fw-normal">Dashboard</span>
        </div>
        <hr />
    </header>

    <div class="d-flex flex-wrap gap-4">
        <div class="flex-fill card-dashboard py-3">
            <div class="d-flex justify-content-between align-items-center px-3">
                <i class="fa-solid fa-film display-6 text-success"></i>
                <span class="display-5 fw-bold">@Model.NumberOfMoviesTotal</span>
            </div>
            <div class="px-3 d-flex flex-column align-items-start">
                <span class="fs-4 fw-normal">Filmes</span>

                @if (Model.NumberOfMoviesAddedCurrentMonth > 0)
                {
                    <span class="fs-6 text-success">+@Model.NumberOfMoviesAddedCurrentMonth este mês</span>
                }
                else
                {
                    <span class="fs-6 opacity-75">sem alteração</span>
                }
            </div>
        </div>

        <div class="flex-fill card-dashboard py-3">
            <div class="d-flex justify-content-between align-items-center px-3">
                <i class="fa-solid fa-clapperboard display-6 text-primary"></i>
                <span class="display-5 fw-bold">@Model.NumberOfSeriesTotal</span>
            </div>
            <div class="px-3 d-flex flex-column align-items-start">
                <span class="fs-4 fw-normal">Séries</span>

                @if (Model.NumberOfSeriesAddedCurrentMonth > 0)
                {
                    <span class="fs-6 text-primary">+@Model.NumberOfSeriesAddedCurrentMonth este mês</span>
                }
                else
                {
                    <span class="fs-6 opacity-75">sem alteração</span>
                }
            </div>
        </div>

        <div class="flex-fill card-dashboard py-3">
            <div class="d-flex justify-content-between align-items-center px-3">
                <i class="fa-solid fa-satellite-dish display-6 text-warning"></i>
                <span class="display-5 fw-bold">@Model.NumberOfChannelsTotal</span>
            </div>
            <div class="px-3 d-flex flex-column align-items-start">
                <span class="fs-4 fw-normal">Canais</span>

                @if (Model.NumberOfChannelsAddedCurrentMonth > 0)
                {
                    <span class="fs-6 text-warning">+@Model.NumberOfChannelsAddedCurrentMonth este mês</span>
                }
                else
                {
                    <span class="fs-6 opacity-75">sem alteração</span>
                }
            </div>
        </div>
    </div>

    <div class="d-none d-lg-flex mt-4">
        <div class="col-lg-12 card-graphic p-3 flex-fill" style="height: 30vh;">
            <span class="fs-6 fw-bold text-opacity-75">Conteúdos adicionados por mês (acumulado)</span>

            <div class="mt-3" style="height: 90%;">
                <canvas id="chart" style="width: 100%; height: 100%;"></canvas>
            </div>
        </div>
    </div>

    <div class="d-flex flex-wrap justify-content-between mt-4">
        <div class="flex-fill p-3 cards-statistics">
            <span class="fs-6 fw-normal text-opacity-75 fw-bold">Adicionados recentemente</span>

            <div class="mt-3 d-flex flex-column gap-2">

                @foreach (var item in Model.LatestContents)
                {
                    <div class="d-flex justify-content-between align-items-center gap-2">

                        <div class="d-flex align-items-center gap-2" style="max-width: 78%;">
                            @{
                                string iconContent = item.Type switch
                                {
                                    ELatestContentType.CHANNEL => "fa-solid fa-satellite-dish",
                                    ELatestContentType.MOVIE => "fa-solid fa-film",
                                    ELatestContentType.SERIES => "fa-solid fa-clapperboard",
                                    _ => "fa-solid fa-film"
                                };
                            }

                            <i class="@Html.Raw(iconContent) opacity-75"></i>
                            <span class="opacity-75 text-truncate">
                                @item.Title
                            </span>
                        </div>

                        <div class="opacity-75 text-nowrap">@item.PublishAt.ToRelativeString()</div>
                    </div>
                }
            </div>
        </div>

        <div class="flex-fill p-3 cards-statistics">
            <span class="fs-6 fw-normal fw-bold">Últimas ações no sistema</span>

            <div class="mt-3 d-flex flex-column gap-2 w-100">

                @foreach (var item in Model.LatestSystemActions)
                {
                    <div class="d-flex justify-content-between align-items-center gap-2">

                        <div class="d-flex align-items-center gap-2" style="max-width: 78%;">
                            <span class="opacity-75 text-truncate">
                                @(item.UserName == User.Identity?.Name ? "você" : item.UserName) @item.ActionDescription
                            </span>
                        </div>

                        <div class="opacity-75 text-nowrap">@item.ActionDate.ToRelativeString()</div>
                    </div>
                }

            </div>
        </div>
    </div>

    <div class="d-flex flex-wrap justify-content-between mt-4 p-3 opacity-75 card-graphic">
        <div>
            <i class="fa-solid fa-arrows-rotate me-2"></i>
            Última sincronização em: @TimeZoneInfo.ConvertTime(DateTime.UtcNow, TimeZoneInfo.FindSystemTimeZoneById("America/Sao_Paulo")).ToString("dd/MM/yyyy HH:mm")
        </div>

        <div>
            <i class="fa-solid fa-database me-2"></i>
            Armazenamento: @Model.DataBaseSizeInMb.ToString("N2") MB usado
        </div>
    </div>

</div>

@section scripts {
    <script>
        var ctx = document.getElementById('chart').getContext('2d');

        var chart = new Chart(ctx, {
            type: 'line',
            data: {
                labels: [ @Html.Raw(string.Join(',', Model.MonthlyContentCounts.Select(c => "'" + c.MonthName + "'"))) ],
                datasets: [{
                    label: 'Conteúdos adicionados (acumulado)',
                    data: [ @Html.Raw(string.Join(',', Model.MonthlyContentCounts.Select(c => c.Count))) ],
                    borderColor: '#1D9E75',
                    backgroundColor: 'rgba(29,158,117,0.15)',
                    fill: true,
                    tension: 0.35,
                    pointRadius: 3,
                    pointBackgroundColor: '#1D9E75'
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: { display: false }
                },
                scales: {
                    x: {
                        grid: { display: false }
                    },
                    y: { beginAtZero: true }
                }
            }
        });
    </script>
}