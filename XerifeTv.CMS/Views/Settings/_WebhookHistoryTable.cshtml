@using XerifeTv.CMS.Modules.Common
@using XerifeTv.CMS.Modules.Integrations.Webhook.Dtos.Response
@using XerifeTv.CMS.Modules.Integrations.Webhook.Entities
@using XerifeTv.CMS.Modules.Integrations.Webhook.Enums
@using XerifeTv.CMS.Modules.Common.Enums

@model PagedList<GetWebhookDispatchHistoryResponseDto>

<div class="table-responsive">
    <table class="table table-striped table-hover align-middle">
        <thead class="table">
            <tr>
                <th>Webhook</th>
                <th>Evento</th>
                <th>Método</th>
                <th>Status</th>
                <th>Data</th>
                <th class="text-end"></th>
            </tr>
        </thead>
        <tbody>
            @if (!Model.Items.Any())
            {
                <tr>
                    <td colspan="6" class="text-center text-muted py-4">
                        <i class="fa-solid fa-circle-info me-2"></i>
                        Nenhum registro encontrado.
                    </td>
                </tr>
            }
            else
            {
                foreach (var item in Model.Items)
                {
                    <tr>
                        <td>
                            <div class="fw-semibold">@item.WebhookName</div>
                            <small class="text-muted text-truncate d-block" style="max-width: 240px;" title="@item.Url">
                                @item.Url
                            </small>
                        </td>

                        <td>
                            <span class="badge bg-secondary">
                                @item.TriggerEvent.GetDescription()
                            </span>
                        </td>

                        <td>
                            @if (item.HttpMethod == EHttpMethod.GET)
                            {
                                <span class="badge text-bg-primary">GET</span>
                            }
                            else if (item.HttpMethod == EHttpMethod.POST)
                            {
                                <span class="badge text-bg-success">POST</span>
                            }
                            else if (item.HttpMethod == EHttpMethod.PUT)
                            {
                                <span class="badge text-bg-warning">PUT</span>
                            }
                            else if (item.HttpMethod == EHttpMethod.PATCH)
                            {
                                <span class="badge text-bg-warning">PATCH</span>
                            }
                            else if (item.HttpMethod == EHttpMethod.DELETE)
                            {
                                <span class="badge text-bg-danger">DELETE</span>
                            }
                        </td>

                        <td>
                            @if (item.Status == EWebhookDispatchStatus.SUCCESS)
                            {
                                <span class="badge bg-success">Sucesso</span>
                            }
                            else if (item.Status == EWebhookDispatchStatus.FAILED)
                            {
                                <span class="badge bg-danger">Falhou</span>
                            }
                            else
                            {
                                <span class="badge bg-primary">Processando</span>
                            }
                        </td>

                        <td>
                            @TimeZoneInfo.ConvertTime(item.StartedAt, TimeZoneInfo.FindSystemTimeZoneById("America/Sao_Paulo")).ToString("dd/MM/yyyy HH:mm")
                        </td>

                        <td class="text-end">
                            <button class="btn btn-sm btn-outline-primary shadow-sm me-1"
                                    type="button"
                                    data-bs-toggle="collapse"
                                    data-bs-target="#details-@item.Id"
                                    aria-expanded="false"
                                    title="Ver detalhes">
                                <i class="fa-solid fa-circle-info"></i>
                            </button>

                            @if (item.Status == EWebhookDispatchStatus.FAILED)
                            {
                                <button class="btn btn-sm btn-outline-warning shadow-sm redispatch-btn"
                                        type="button"
                                        onclick="redispatchWebhook('@item.Id', this)"
                                        title="Disparar manualmente">
                                    <i class="fa-solid fa-rotate-right me-1"></i> Re-disparar
                                </button>
                            }
                        </td>
                    </tr>

                    <!-- Painel Expandível de Detalhes -->
                    <tr>
                        <td colspan="6" class="p-0 border-0">
                            <div class="collapse" id="details-@item.Id">
                                <div class="card card-body m-2 bg-body-tertiary shadow-sm">
                                    <div class="row g-3">
                                        <div class="col-md-6">
                                            <h6 class="fw-semibold border-bottom pb-2 mb-3">
                                                <i class="fa-solid fa-paper-plane me-1"></i> Requisição
                                            </h6>

                                            <div class="mb-2">
                                                <span class="fw-semibold">URL:</span>
                                                <span class="text-break">@item.Url</span>
                                            </div>

                                            @if (!string.IsNullOrWhiteSpace(item.RequestHeaders))
                                            {
                                                <div class="mb-2">
                                                    <span class="fw-semibold d-block mb-1">Headers:</span>
                                                    <textarea class="form-control font-monospace subtle-scrollbar" rows="3" readonly>@item.RequestHeaders</textarea>
                                                </div>
                                            }

                                            @if (!string.IsNullOrWhiteSpace(item.RequestBody))
                                            {
                                                <div class="mb-2">
                                                    <span class="fw-semibold d-block mb-1">Payload:</span>
                                                    <textarea class="form-control font-monospace subtle-scrollbar" rows="4" readonly>@item.RequestBody</textarea>
                                                </div>
                                            }
                                        </div>

                                        <div class="col-md-6">
                                            <h6 class="fw-semibold border-bottom pb-2 mb-3">
                                                <i class="fa-solid fa-reply me-1"></i> Resposta
                                            </h6>

                                            <div class="mb-2">
                                                <span class="fw-semibold">Código Status:</span>
                                                @if (item.ResponseStatusCode.HasValue)
                                                {
                                                    var isOk = item.ResponseStatusCode >= 200 && item.ResponseStatusCode < 300;
                                                    <span class="badge @(isOk ? "bg-success" : "bg-danger")">@item.ResponseStatusCode</span>
                                                }
                                                else
                                                {
                                                    <span class="text-muted">Nenhum</span>
                                                }
                                            </div>

                                            @if (!string.IsNullOrWhiteSpace(item.ResponseHeaders))
                                            {
                                                <div class="mb-2">
                                                    <span class="fw-semibold d-block mb-1">Headers Resposta:</span>
                                                    <textarea class="form-control font-monospace subtle-scrollbar" rows="3" readonly>@item.ResponseHeaders</textarea>
                                                </div>
                                            }

                                            @if (!string.IsNullOrWhiteSpace(item.ResponseBody))
                                            {
                                                <div class="mb-2">
                                                    <span class="fw-semibold d-block mb-1">Corpo da Resposta:</span>
                                                    <textarea class="form-control font-monospace subtle-scrollbar" rows="4" readonly>@item.ResponseBody</textarea>
                                                </div>
                                            }

                                            @if (item.AttemptsLog != null && item.AttemptsLog.Any())
                                            {
                                                <div class="mt-3">
                                                    <span class="fw-semibold d-block mb-1">Histórico de Tentativas:</span>
                                                    <ul class="list-group">
                                                        @foreach (var attempt in item.AttemptsLog)
                                                        {
                                                            <li class="list-group-item d-flex justify-content-between align-items-center">
                                                                <span>Tentativa #@attempt.AttemptNumber - @attempt.AttemptedAt.ToLocalTime().ToString("HH:mm:ss")</span>
                                                                @if (attempt.Success)
                                                                {
                                                                    <span class="badge bg-success">Sucesso (@attempt.StatusCode)</span>
                                                                }
                                                                else
                                                                {
                                                                    <span class="badge bg-danger" title="@attempt.ErrorMessage">
                                                                        Falha (@(attempt.StatusCode?.ToString() ?? attempt.ErrorType ?? "Erro"))
                                                                    </span>
                                                                }
                                                            </li>
                                                        }
                                                    </ul>
                                                </div>
                                            }
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>

@if (Model.TotalPageCount > 1)
{
    int currentPage = Model.CurrentPage;
    int totalPages = (int)Model.TotalPageCount;
    int maxPagesToShow = 3;
    int half = maxPagesToShow / 2;

    <div class="d-flex justify-content-center align-items-center mt-3">
        <ul class="pagination mb-0">

            <li class="page-item @(Model.HasPrevious ? "" : "disabled")">
                <button class="page-link shadow-none"
                        type="button"
                        onclick="loadWebhookHistory(@(currentPage - 1))">
                    &laquo;
                </button>
            </li>

            @if (totalPages <= maxPagesToShow + 2)
            {
                for (int i = 1; i <= totalPages; i++)
                {
                    <li class="page-item @(currentPage == i ? "active" : "")">
                        <button class="page-link shadow-none"
                                type="button"
                                onclick="loadWebhookHistory(@i)">
                            @i
                        </button>
                    </li>
                }
            }
            else
            {
                <!-- Primeira página -->
                <li class="page-item @(currentPage == 1 ? "active" : "")">
                    <button class="page-link shadow-none"
                            type="button"
                            onclick="loadWebhookHistory(1)">
                        1
                    </button>
                </li>

                @if (currentPage - half > 2)
                {
                    <li class="page-item disabled">
                        <span class="page-link">...</span>
                    </li>
                }

                int start = Math.Max(2, currentPage - half);
                int end = Math.Min(totalPages - 1, currentPage + half);

                if (currentPage <= half + 2)
                {
                    end = Math.Min(1 + maxPagesToShow, totalPages - 1);
                }
                else if (currentPage >= totalPages - half - 1)
                {
                    start = Math.Max(totalPages - maxPagesToShow, 2);
                }

               
                @for (int i = start; i <= end; i++)
                {
                    <li class="page-item @(currentPage == i ? "active" : "")">
                        <button class="page-link shadow-none"
                                type="button"
                                onclick="loadWebhookHistory(@i)">
                            @i
                        </button>
                    </li>
                }

                @if (end < totalPages - 1)
                {
                    <li class="page-item disabled">
                        <span class="page-link">...</span>
                    </li>
                }

                <!-- Última página -->
                <li class="page-item @(currentPage == totalPages ? "active" : "")">
                    <button class="page-link shadow-none"
                            type="button"
                            onclick="loadWebhookHistory(@totalPages)">
                        @totalPages
                    </button>
                </li>
            }

            <li class="page-item @(Model.HasNext ? "" : "disabled")">
                <button class="page-link shadow-none"
                        type="button"
                        onclick="loadWebhookHistory(@(currentPage + 1))">
                    &raquo;
                </button>
            </li>

        </ul>
    </div>
}