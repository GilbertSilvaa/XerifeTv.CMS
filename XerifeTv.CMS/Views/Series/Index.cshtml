@using XerifeTv.CMS.Modules.Series.Dtos.Response
@using XerifeTv.CMS.Modules.Series.Enums

@model IEnumerable<GetSeriesResponseDto>;

@{
    ViewData["Title"] = "Séries";

    ICollection<string[]> filters = [];
    filters.Add([ESeriesSearchFilter.TITLE.ToString().ToLower(), "Título"]);
    filters.Add([ESeriesSearchFilter.CATEGORY.ToString().ToLower(), "Categoria"]);
    filters.Add([ESeriesSearchFilter.RELEASE_YEAR.ToString().ToLower(), "Ano de Lançamento"]);
    filters.Add([ESeriesSearchFilter.PARENTAL_RATING.ToString().ToLower(), "Classificação Indicativa"]);
    filters.Add([ESeriesSearchFilter.ONLY_DISABLED.ToString().ToLower(), "Somente Desativados"]);
    filters.Add([ESeriesSearchFilter.FRANCHISE.ToString().ToLower(), "Franquia"]);

    var currentView = Context.Request.Cookies["series_view"] == "table" ? "table" : "grid";
}

<style>
    #seriesViews #tableView {
        display: none;
    }

    @@media (min-width: 768px) {
        #seriesViews[data-view="table"] #gridView {
            display: none;
        }

        #seriesViews[data-view="table"] #tableView {
            display: block;
        }
    }
</style>

<div class="container">
    <header>
        <div class="d-flex align-items-center justify-content-between gap-4">
            <span class="fs-3 fw-normal">Séries</span>

            @if (!User.IsInRole("visitor"))
            {
                <a class="btn btn-primary" asp-controller="Series" asp-action="Form">
                    <i class="fa-solid fa-plus"></i> Cadastrar
                </a>
            }
        </div>
        <hr />
    </header>

    <div class="row mb-3 justify-content-between">
        <a class="d-none d-md-block col-1 fs-5" role="button" asp-controller="Series" asp-action="Index">
            <i class="fa-solid fa-rotate"></i>
        </a>

        <div class="col-md-8 col-lg-5 d-flex align-items-center gap-2">
            <form class="input-group input-group-sm flex-grow-1"
                  asp-controller="Series"
                  asp-action="Index"
                  method="get">

                @* <input type="hidden"
                   name="currentPage"
                   value="@(ViewBag.Filter is not null ? ViewBag.CurrentPage : 1)" /> *@

                <select class="form-select shadow-none" name="filter">
                    @foreach (var filter in filters)
                    {
                        if (filter[0].Equals(ViewBag.Filter))
                        {
                            <option value="@filter[0]" selected>@filter[1]</option>
                        }
                        else
                        {
                            <option value="@filter[0]">@filter[1]</option>
                        }
                    }
                </select>

                <input type="text"
                       name="search"
                       class="form-control shadow-none"
                       value="@ViewBag.Search"
                       required>
                <button class="btn btn-success shadow-none" type="submit">
                    <i class="fa-solid fa-magnifying-glass"></i>
                </button>
            </form>

            <div class="btn-group btn-group-sm flex-shrink-0 d-none d-md-flex" role="group" aria-label="Modo de visualização">
                <button type="button"
                        class="btn btn-outline-secondary shadow-sm @(currentView == "grid" ? "active" : "")"
                        data-view="grid" title="Grade">
                    <i class="fa-solid fa-table-cells-large"></i>
                </button>
                <button type="button"
                        class="btn btn-outline-secondary shadow-sm @(currentView == "table" ? "active" : "")"
                        data-view="table" title="Tabela">
                    <i class="fa-solid fa-table-list"></i>
                </button>
            </div>
        </div>
    </div>

    <div id="seriesViews" data-view="@currentView">

        <div id="gridView" class="row gap-3">
            @foreach (var serie in Model)
            {
                <div class="card col-md-4 col-xl-2 pt-2">
                    <div class="w-auto h-100 position-relative" style="cursor: pointer;" data-bs-toggle="modal" data-bs-target="#seriesDetailsModal-@serie.Id">
                        <img src="@serie.PosterUrl"
                             onerror="this.onerror=null; this.src='/assets/poster_default.jpg';"
                             class="card-img-top object-fit-cover"
                             alt="@serie.Title"
                             loading="lazy"
                             style="height: 14rem;">

                        @if (@serie.Disabled)
                        {
                            <span class="position-absolute text-danger"
                                  style="top: 6px; left: 8px; font-size: 24px;">
                                <i class="fa-solid fa-circle-exclamation"></i>
                            </span>
                        }
                    </div>

                    <div class="card-body" style="padding: 1rem 0.25rem;">
                        <h5 class="card-title text-nowrap overflow-hidden text-truncate text-center">@serie.Title</h5>

                        <div class="d-flex justify-content-center gap-2 mt-3">
                            <a class="btn btn-sm btn-info"
                               asp-controller="Series"
                               asp-action="Episodes"
                               asp-route-id="@serie.Id">
                                <i class="fa-solid fa-list"></i> Episódios
                            </a>

                            @if (!User.IsInRole("visitor"))
                            {
                                <a class="btn btn-sm btn-primary"
                                   asp-controller="Series"
                                   asp-action="Form"
                                   asp-route-id="@serie.Id">
                                    <i class="fa-solid fa-pen-to-square"></i> Editar
                                </a>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>

        <div id="tableView" class="table-responsive">
            <table class="table table-hover table-sm align-middle">
                <thead>
                    <tr>
                        <th style="width: 64px;"></th>
                        <th class="p-2">Título</th>
                        <th class="d-none d-lg-table-cell p-2">Ano</th>
                        <th class="d-none d-lg-table-cell p-2">Classificação</th>
                        <th class="d-none d-lg-table-cell p-2">Avaliação</th>
                        <th class="p-2">Status</th>
                        <th class="text-end p-2">...</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var serie in Model)
                    {
                        <tr>
                            <td>
                                <img src="@serie.PosterUrl"
                                     onerror="this.onerror=null; this.src='/assets/poster_default.jpg';"
                                     class="rounded object-fit-cover"
                                     width="40" height="56"
                                     alt="@serie.Title"
                                     loading="lazy" />
                            </td>
                            <td class="fw-semibold">@serie.Title</td>
                            <td class="d-none d-lg-table-cell">@serie.ReleaseYear</td>
                            <td class="d-none d-lg-table-cell">@(serie.ParentalRating == 0 ? "L" : serie.ParentalRating)</td>
                            <td class="d-none d-lg-table-cell">@serie.Review.ToString("0.00")</td>
                            <td>
                                @if (serie.Disabled)
                                {
                                    <span class="badge text-bg-danger">Desativado</span>
                                }
                                else
                                {
                                    <span class="badge text-bg-success">Ativo</span>
                                }
                            </td>
                            <td class="text-end text-nowrap">
                                <button type="button"
                                        class="btn btn-sm btn-outline-info shadow-sm"
                                        data-bs-toggle="modal"
                                        data-bs-target="#seriesDetailsModal-@serie.Id"
                                        title="Detalhes">
                                    <i class="fa-solid fa-eye"></i>
                                </button>

                                <a class="btn btn-sm btn-outline-info shadow-sm"
                                   asp-controller="Series"
                                   asp-action="Episodes"
                                   asp-route-id="@serie.Id"
                                   title="Episódios">
                                    <i class="fa-solid fa-list"></i>
                                </a>

                                @if (!User.IsInRole("visitor"))
                                {
                                    <a class="btn btn-sm btn-outline-primary shadow-sm"
                                       asp-controller="Series"
                                       asp-action="Form"
                                       asp-route-id="@serie.Id"
                                       title="Editar">
                                        <i class="fa-solid fa-pen-to-square"></i>
                                    </a>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    @if (!Model.Any())
    {
        <p>Nenhum registro encontrado.</p>
    }

    @foreach (var serie in Model)
    {
        @await Html.PartialAsync("_DetailsModal", serie)
    }

    @await Html.PartialAsync("_Pagination")
</div>

<script>
    (function () {
        const container = document.getElementById('seriesViews');
        const buttons = document.querySelectorAll('button[data-view]');

        buttons.forEach(b => b.addEventListener('click', function () {
            container.dataset.view = b.dataset.view;
            buttons.forEach(x => x.classList.toggle('active', x === b));
            document.cookie = 'series_view=' + b.dataset.view + '; path=/; max-age=31536000; SameSite=Lax';
        }));
    })();
</script>