@using XerifeTv.CMS.Modules.Series.Dtos.Response
@using XerifeTv.CMS.Modules.Series.Enums

@model IEnumerable<GetSeriesResponseDto>;

@{
    ViewData["Title"] = "Séries";

    ICollection<string[]> filters = [];
    filters.Add([ESeriesSearchFilter.TITLE.ToString().ToLower(), "Titulo"]);
    filters.Add([ESeriesSearchFilter.CATEGORY.ToString().ToLower(), "Categoria"]);
    filters.Add([ESeriesSearchFilter.RELEASE_YEAR.ToString().ToLower(), "Ano de Lançamento"]);
    filters.Add([ESeriesSearchFilter.PARENTAL_RATING.ToString().ToLower(), "Classificação Indicativa"]);
    filters.Add([ESeriesSearchFilter.ONLY_DISABLED.ToString().ToLower(), "Somente Desativados"]);
    filters.Add([ESeriesSearchFilter.FRANCHISE.ToString().ToLower(), "Franquia"]);
}

<div class="container">
    <header>
        <div class="d-flex align-items-center justify-content-between gap-4">
            <span class="fs-3 fw-normal">Séries</span>

            @if (!User.IsInRole("visitor"))
            {
                <a class="btn btn-primary" asp-controller="Series" asp-action="Form">
                    <i class="fa-solid fa-plus"></i> Cadastrar
                </a>
            }
        </div>
        <hr />
    </header>

    <div class="row mb-3 justify-content-between">
        <a class="d-none d-md-block col-1 fs-5" role="button" asp-controller="Series" asp-action="Index">
            <i class="fa-solid fa-rotate"></i>
        </a>

        <div class="col-md-8 col-lg-5">
            <form class="input-group input-group-sm"
                  asp-controller="Series"
                  asp-action="Index"
                  method="get">

                @* <input type="hidden"
                       name="currentPage"
                       value="@(ViewBag.Filter is not null ? ViewBag.CurrentPage : 1)" /> *@

                <select class="form-select shadow-none" name="filter">
                    @foreach (var filter in filters)
                    {
                        if (filter[0].Equals(ViewBag.Filter))
                        {
                            <option value="@filter[0]" selected>@filter[1]</option>
                        }
                        else
                        {
                            <option value="@filter[0]">@filter[1]</option>
                        }
                    }
                </select>

                <input type="text"
                       name="search"
                       class="form-control shadow-none"
                       value="@ViewBag.Search"
                       required>
                <button class="btn btn-success shadow-none" type="submit">
                    <i class="fa-solid fa-magnifying-glass"></i>
                </button>
            </form>
        </div>
    </div>

    <div class="row gap-3">
        @foreach (var serie in Model)
        {
            <div class="card col-md-4 col-xl-2 pt-2">
                <div class="w-auto h-100 position-relative" style="cursor: pointer;" data-bs-toggle="modal" data-bs-target="#seriesDetailsModal-@serie.Id">
                    <img src="@serie.PosterUrl"
                         onerror="this.onerror=null; this.src='/assets/poster_default.jpg';"
                         class="card-img-top object-fit-cover"
                         alt="@serie.Title"
                         loading="lazy"
                         style="height: 14rem;">

                    @if (@serie.Disabled)
                    {
                        <span class="position-absolute text-danger"
                              style="top: 6px; left: 8px; font-size: 24px;">
                            <i class="fa-solid fa-circle-exclamation"></i>
                        </span>
                    }
                </div>

                <div class="card-body" style="padding: 1rem 0.25rem;">
                    <h5 class="card-title text-nowrap overflow-hidden text-truncate text-center">@serie.Title</h5>

                    <div class="d-flex justify-content-center gap-2 mt-3">
                        <a class="btn btn-sm btn-info"
                           asp-controller="Series"
                           asp-action="Episodes"
                           asp-route-id="@serie.Id">
                            <i class="fa-solid fa-list"></i> Episódios
                        </a>

                        @if (!User.IsInRole("visitor"))
                        {
                            <a class="btn btn-sm btn-primary"
                               asp-controller="Series"
                               asp-action="Form"
                               asp-route-id="@serie.Id">
                                <i class="fa-solid fa-pen-to-square"></i> Editar
                            </a>
                        }

                    </div>
                </div>
            </div>

            @await Html.PartialAsync("_DetailsModal", serie)
        }

        @if (Model?.Count() <= 0)
        {
            <p>Nenhum registro encontrado.</p>
        }
    </div>

    @await Html.PartialAsync("_Pagination")
</div>
