@using XerifeTv.CMS.Modules.Movie.Dtos.Response
@using XerifeTv.CMS.Modules.Movie.Enums

@model IEnumerable<GetMovieResponseDto>;

@{
    ViewData["Title"] = "Filmes";

    ICollection<string[]> filters = [];
    filters.Add([EMovieSearchFilter.TITLE.ToString().ToLower(), "Título"]);
    filters.Add([EMovieSearchFilter.CATEGORY.ToString().ToLower(), "Categoria"]);
    filters.Add([EMovieSearchFilter.RELEASE_YEAR.ToString().ToLower(), "Ano de Lançamento"]);
    filters.Add([EMovieSearchFilter.PARENTAL_RATING.ToString().ToLower(), "Classificação Indicativa"]);
    filters.Add([EMovieSearchFilter.ONLY_DISABLED.ToString().ToLower(), "Somente Desativados"]);
    filters.Add([EMovieSearchFilter.FRANCHISE.ToString().ToLower(), "Franquia"]);

    var currentView = Context.Request.Cookies["movies_view"] == "table" ? "table" : "grid";
}

<style>
    #moviesViews[data-view="grid"] #tableView,
    #moviesViews[data-view="table"] #gridView {
        display: none;
    }

    @@media (max-width: 767.98px) {
        #moviesViews #tableView {
            display: none;
        }

        #moviesViews #gridView {
            display: flex;
        }
    }
</style>

<div class="container">
    <header>
        <div class="d-flex align-items-center justify-content-between gap-4">
            <span class="fs-3 fw-normal">Filmes</span>

            @if (!User.IsInRole("visitor"))
            {
                <a class="btn btn-primary" asp-controller="Movies" asp-action="Form">
                    <i class="fa-solid fa-plus"></i> Cadastrar
                </a>
            }
        </div>
        <hr />
    </header>

    <div class="row mb-3 justify-content-between">
        <a class="d-none d-md-block col-1 fs-5" role="button" asp-controller="Movies" asp-action="Index">
            <i class="fa-solid fa-rotate"></i>
        </a>

        <div class="col-md-8 col-lg-5 d-flex align-items-center gap-2">
            <form class="input-group input-group-sm flex-grow-1"
                  asp-controller="Movies"
                  asp-action="Index"
                  method="get">

                @*  <input type="hidden"
                   name="currentPage"
                   value="@(ViewBag.Filter is not null ? ViewBag.CurrentPage : 1)" /> *@

                <select class="form-select shadow-none" name="filter">
                    @foreach (var filter in filters)
                    {
                        if (filter[0].Equals(ViewBag.Filter))
                        {
                            <option value="@filter[0]" selected>@filter[1]</option>
                        }
                        else
                        {
                            <option value="@filter[0]">@filter[1]</option>
                        }
                    }
                </select>

                <input type="text"
                       name="search"
                       class="form-control shadow-none"
                       value="@ViewBag.Search"
                       required>
                <button class="btn btn-success shadow-none" type="submit">
                    <i class="fa-solid fa-magnifying-glass"></i>
                </button>
            </form>

            <div class="btn-group btn-group-sm flex-shrink-0 d-none d-md-flex" role="group" aria-label="Modo de visualização">
                <button type="button"
                        class="btn btn-outline-secondary shadow-sm @(currentView == "grid" ? "active" : "")"
                        data-view="grid" title="Grade">
                    <i class="fa-solid fa-table-cells-large"></i>
                </button>
                <button type="button"
                        class="btn btn-outline-secondary shadow-sm @(currentView == "table" ? "active" : "")"
                        data-view="table" title="Tabela">
                    <i class="fa-solid fa-table-list"></i>
                </button>
            </div>
        </div>
    </div>


    @await Html.PartialAsync("_VideoModal")

    <div id="moviesViews" data-view="@currentView">

        <div id="gridView" class="row gap-3">
            @foreach (var movie in Model)
            {
                <div class="card col-md-4 col-xl-2 pt-2">
                    <div class="w-auto h-100 position-relative" style="cursor: pointer;" data-bs-toggle="modal" data-bs-target="#movielDetailsModal-@movie?.Id">
                        <img src="@movie?.PosterUrl"
                             onerror="this.onerror=null; this.src='/assets/poster_default.jpg';"
                             class="card-img-top object-fit-cover"
                             alt="@movie?.Title"
                             loading="lazy" style="height: 14rem;" />

                        @if (!string.IsNullOrEmpty(@movie?.Video?.Subtitle))
                        {
                            <span class="position-absolute rounded-0 fw-bolder p-1 bg-warning text-white"
                                  style="bottom: 6px; right: 6px; font-size: 12px; padding: 0.25rem 0.4rem !important;">
                                CC
                            </span>
                        }

                        @if (@movie?.Disabled ?? false)
                        {
                            <span class="position-absolute text-danger"
                                  style="top: 6px; left: 8px; font-size: 24px;">
                                <i class="fa-solid fa-circle-exclamation"></i>
                            </span>
                        }
                    </div>

                    <div class="card-body" style="padding: 1rem 0.25rem;">
                        <h5 class="card-title text-nowrap overflow-hidden text-truncate text-center">@movie?.Title</h5>

                        <div class="d-flex justify-content-center gap-2 mt-3">

                            <a class="btn btn-sm btn-info"
                               data-bs-toggle="modal"
                               data-bs-target="#videoModal"
                               data-bs-title="@movie?.Title"
                               data-bs-banner="@movie?.BannerUrl"
                               data-bs-video-subtitle="@movie?.Video?.Subtitle"
                               data-bs-video-resolver="@movie?.UrlResolverPath">
                                <i class="fa-solid fa-play"></i> Play
                            </a>

                            @if (!User.IsInRole("visitor"))
                            {
                                <a class="btn btn-sm btn-primary"
                                   asp-controller="Movies"
                                   asp-action="Form"
                                   asp-route-id="@movie?.Id">
                                    <i class="fa-solid fa-pen-to-square"></i> Editar
                                </a>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>

        <div id="tableView" class="table-responsive">
            <table class="table table-hover table-sm align-middle">
                <thead>
                    <tr>
                        <th style="width: 64px;"></th>
                        <th class="p-2">Título</th>
                        <th class="d-none d-lg-table-cell p-2">Ano</th>
                        <th class="d-none d-lg-table-cell p-2">Classificação</th>
                        <th class="d-none d-lg-table-cell p-2">Duração</th>
                        <th class="d-none d-lg-table-cell p-2">Avaliação</th>
                        <th class="p-2">Status</th>
                        <th class="text-end p-2">...</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var movie in Model!)
                    {
                        <tr>
                            <td>
                                <img src="@movie?.PosterUrl"
                                     onerror="this.onerror=null; this.src='/assets/poster_default.jpg';"
                                     class="rounded object-fit-cover"
                                     width="40" height="56"
                                     alt="@movie?.Title"
                                     loading="lazy" />
                            </td>
                            <td class="fw-semibold">
                                @movie?.Title
                                @if (!string.IsNullOrEmpty(movie?.Video?.Subtitle))
                                {
                                    <span class="badge text-bg-warning text-white ms-1">CC</span>
                                }
                            </td>
                            <td class="d-none d-lg-table-cell">@movie?.ReleaseYear</td>
                            <td class="d-none d-lg-table-cell">@(movie?.ParentalRating == 0 ? "L" : movie?.ParentalRating)</td>
                            <td class="d-none d-lg-table-cell">@movie?.DurationHHmm</td>
                            <td class="d-none d-lg-table-cell">@movie?.Review.ToString("0.00")</td>
                            <td>
                                @if (movie?.Disabled ?? false)
                                {
                                    <span class="badge text-bg-danger">Desativado</span>
                                }
                                else
                                {
                                    <span class="badge text-bg-success">Ativo</span>
                                }
                            </td>
                            <td class="text-end text-nowrap">

                                <button type="button"
                                        class="btn btn-sm btn-outline-info shadow-sm"
                                        data-bs-toggle="modal"
                                        data-bs-target="#movielDetailsModal-@movie?.Id"
                                        title="Detalhes">
                                    <i class="fa-solid fa-eye"></i>
                                </button>

                                <a class="btn btn-sm btn-outline-info shadow-sm"
                                   data-bs-toggle="modal"
                                   data-bs-target="#videoModal"
                                   data-bs-title="@movie?.Title"
                                   data-bs-banner="@movie?.BannerUrl"
                                   data-bs-video-subtitle="@movie?.Video?.Subtitle"
                                   data-bs-video-resolver="@movie?.UrlResolverPath"
                                   title="Play">
                                    <i class="fa-solid fa-play"></i>
                                </a>

                                @if (!User.IsInRole("visitor"))
                                {
                                    <a class="btn btn-sm btn-outline-primary shadow-sm"
                                       asp-controller="Movies"
                                       asp-action="Form"
                                       asp-route-id="@movie?.Id"
                                       title="Editar">
                                        <i class="fa-solid fa-pen-to-square"></i>
                                    </a>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    @if (Model?.Count() <= 0)
    {
        <p>Nenhum registro encontrado.</p>
    }

    @foreach (var movie in Model!)
    {
        @await Html.PartialAsync("_DetailsModal", movie)
    }

    @await Html.PartialAsync("_Pagination")
</div>

<script>
    (function () {
        const container = document.getElementById('moviesViews');
        const buttons = document.querySelectorAll('[data-view]');

        buttons.forEach(b => b.addEventListener('click', function () {
            const view = b.dataset.view;
            container.dataset.view = view;
            buttons.forEach(x => x.classList.toggle('active', x === b));
            document.cookie = 'movies_view=' + view + '; path=/; max-age=31536000; SameSite=Lax';
        }));
    })();
</script>