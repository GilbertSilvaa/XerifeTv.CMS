@using XerifeTv.CMS.Modules.ContentCalendar.Dtos.Response
@using XerifeTv.CMS.Modules.ContentCalendar.Enums
@using XerifeTv.CMS.Modules.ContentCalendar

@model ContentScheduleDetailsResponseDto

@{
    ViewData["Title"] = "Calendário de Conteúdo";
    var schedule = Model.Schedule;
    var diagnostic = Model.Diagnostic;
}

<style>
    .cc-meta {
        display: flex;
        flex-direction: column;
        gap: 0.15rem;
    }

    .cc-meta-label {
        font-size: 0.75rem;
        text-transform: uppercase;
        letter-spacing: 0.04em;
        color: var(--bs-secondary-color);
        margin: 0;
    }

    .cc-meta-value {
        font-weight: 600;
        font-size: 1rem;
        margin: 0;
    }

    .cc-section-title {
        font-size: 0.9rem;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        color: var(--bs-secondary-color);
        margin-bottom: 0.75rem;
    }
</style>

<div class="container">
    <header>
        <div class="d-flex align-items-center justify-content-between gap-4">
            <div class="d-flex align-items-center gap-4">
                <a asp-action="Index" class="fs-4">
                    <i class="fa fa-undo" aria-hidden="true"></i>
                </a>
                <span class="fs-3 fw-normal">Detalhes do agendamento</span>
            </div>
            <div class="d-flex align-items-center gap-2">
                @if (!schedule.IsRegistered)
                {
                    <button type="button" class="btn btn-success shadow-none" id="btn-shortcut" data-id="@schedule.Id">
                        <i class="fa-solid fa-arrow-up-right-from-square"></i> Cadastrar conteúdo
                    </button>
                }
            </div>
        </div>
        <hr />
    </header>

    <div class="row g-4">
        <div class="col-12">
            <div class="card shadow-sm">
                <div class="card-body">
                    <div class="d-flex align-items-start justify-content-between gap-3 mb-3">
                        <div style="
                            height: 100%;
                            display: flex;
                            flex-direction: column;
                            justify-content: space-between;
                            height: 80px;">
                            <h4 class="card-title mb-1">@schedule.Title</h4>
                            <div class="d-flex flex-wrap gap-2 mt-2">
                                <span class="badge @ContentScheduleDisplay.GetStatusCssClass(schedule.Status)">
                                    @ContentScheduleDisplay.GetStatusLabel(schedule.Status)
                                </span>
                                <span class="badge text-bg-secondary">
                                    @ContentScheduleDisplay.GetTypeLabel(schedule.ContentType)
                                </span>
                                <span class="badge text-bg-light border">
                                    @ContentScheduleDisplay.GetOriginLabel(schedule.Origin)
                                </span>
                            </div>
                        </div>
                        @if (!string.IsNullOrWhiteSpace(schedule.ImageUrl))
                        {
                            <img src="@schedule.ImageUrl" class="card-img-top" alt="@schedule.Title"
                                 style="object-fit: cover; max-height: 100px; max-width: 110px;" />
                        }
                    </div>

                    <hr class="my-3" />

                    <div class="row g-3">
                        <div class="col-sm-6 col-lg-4">
                            <div class="cc-meta">
                                <p class="cc-meta-label">Data prevista</p>
                                <p class="cc-meta-value">@schedule.ScheduledDate.ToString("dd/MM/yyyy")</p>
                            </div>
                        </div>
                        @if (schedule.SeasonNumber is not null)
                        {
                            <div class="col-sm-6 col-lg-4">
                                <div class="cc-meta">
                                    <p class="cc-meta-label">Temporada / Episódio</p>
                                    <p class="cc-meta-value">T@(schedule.SeasonNumber)E@(schedule.EpisodeNumber)</p>
                                </div>
                            </div>
                        }
                        @if (!string.IsNullOrWhiteSpace(schedule.ImdbId))
                        {
                            <div class="col-sm-6 col-lg-4">
                                <div class="cc-meta">
                                    <p class="cc-meta-label">IMDb ID</p>
                                    <p class="cc-meta-value">@schedule.ImdbId</p>
                                </div>
                            </div>
                        }
                        @if (schedule.RegisteredAt is not null)
                        {
                            <div class="col-sm-6 col-lg-4">
                                <div class="cc-meta">
                                    <p class="cc-meta-label">Cadastrado em</p>
                                    <p class="cc-meta-value">@schedule.RegisteredAt?.ToString("dd/MM/yyyy HH:mm")</p>
                                </div>
                            </div>
                        }
                        <div class="col-sm-6 col-lg-4">
                            <div class="cc-meta">
                                <p class="cc-meta-label">Criado em</p>
                                <p class="cc-meta-value">@schedule.CreateAt.ToString("dd/MM/yyyy")</p>
                            </div>
                        </div>
                    </div>

                    <div class="alert alert-light d-flex align-items-start gap-2 mt-4 mb-0">
                        <i class="fa-solid fa-circle-info mt-1"></i>
                        <div>
                            <strong class="d-block mb-1">Diagnóstico de vínculo</strong>
                            <span>@diagnostic.Message</span>
                        </div>
                    </div>
                </div>

                <div class="card-footer bg-transparent d-flex flex-wrap gap-2 justify-content-between">
                    <form asp-action="Delete" method="post" data-confirm="Deseja realmente remover o agendamento?">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@schedule.Id" />
                        <button type="submit" class="btn btn-outline-danger shadow-none">
                            <i class="fa-solid fa-trash"></i> Excluir
                        </button>
                    </form>

                    <div class="d-flex gap-4">
                        @if (!schedule.IsRegistered && diagnostic.CanLinkManually)
                        {
                            <button type="button" class="btn btn-outline-info shadow-none" data-bs-toggle="modal" data-bs-target="#linkModal">
                                <i class="fa-solid fa-link"></i> Vincular manualmente
                            </button>
                        }

                        @if (schedule.CanEdit)
                        {
                            <form asp-action="UpdateDate" method="post" class="d-flex gap-2 align-items-center" data-confirm="Deseja realmente alterar a data de agendamento?">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="Id" value="@schedule.Id" />
                                <input type="date" class="form-control form-control-sm" name="ScheduledDate"
                                       value="@schedule.ScheduledDate.ToString("yyyy-MM-dd")" style="max-width: 160px;" />
                                <button type="submit" class="btn btn-outline-primary shadow-none w-100">
                                    <i class="fa-solid fa-calendar-day"></i> Alterar data
                                </button>
                            </form>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Link modal -->
<div class="modal fade" id="linkModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <form asp-action="Link" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="Id" value="@schedule.Id" />
                <div class="modal-header">
                    <h5 class="modal-title">Vincular conteúdo</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    @if (schedule.IsEpisode)
                    {
                        <div class="mb-3">
                            <label class="form-label">ID da série (interno)</label>
                            <input type="text" class="form-control" name="SeriesId" required />
                        </div>
                    }
                    <div class="mb-3">
                        <label class="form-label">ID do conteúdo (interno)</label>
                        <input type="text" class="form-control" name="ContentId" required />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary shadow-none" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-primary shadow-none">Vincular</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section scripts {
    <script>
        document.getElementById('btn-shortcut')?.addEventListener('click', async () => {
            const btn = document.getElementById('btn-shortcut');
            const id = btn.dataset.id;
            const response = await fetch(`/ContentCalendar/Shortcut?id=${id}`);
            const result = await response.json();
            if (result.isSuccess && result.url) {
                if (result.warningMessage) alert(result.warningMessage);
                window.location.href = result.url;
            } else {
                alert(result.error || 'Não foi possível abrir o atalho.');
            }
        });
    </script>
}
